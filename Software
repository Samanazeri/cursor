class HesabdarSystem:
    def __init__(self):
        self.karmandan = []
        self.mahaleh_hoghoogh = []
        self.log_ha = []
    
    def ezafe_kardan_karmand(self, esm, hoghoogh_asli, saat_kar, saat_ezafe, darsad_maliat, hazineh=0):
        try:
            hoghoogh_paye = hoghoogh_asli * saat_kar / 160
            
            if saat_ezafe > 0:
                hoghoogh_ezafe = (hoghoogh_asli / 160) * 1.5 * saat_ezafe
            else:
                hoghoogh_ezafe = 0
            
            kol_nakhales = hoghoogh_paye + hoghoogh_ezafe + hazineh
            maliat = kol_nakhales * darsad_maliat
            hoghoogh_khaless = kol_nakhales - maliat
            
            karmand_info = {
                'esm': esm,
                'nakhales': kol_nakhales,
                'maliat': maliat, 
                'khaless': hoghoogh_khaless,
                'tarikh': '1402/10/15'
            }
            
            self.karmandan.append(karmand_info)
            self.log_ha.append(f"کارمند {esm} اضافه شد")
            return karmand_info
            
        except Exception as e:
            print(f"خطا در محاسبه: {e}")
            return None
    
